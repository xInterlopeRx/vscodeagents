# Default to loopback. Set to the server's LAN address only when direct LAN access is needed.
MCP_PUBLISHED_HOST=127.0.0.1
MCP_PUBLISHED_PORT=3100

# Pin a published version for repeatable deployments.
MCP_IMAGE=ghcr.io/xinterloperx/vscode-docs-mcp:0.1.0

# Generate a private value with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters

# For browser-based clients, list exact allowed origins, comma-separated.
MCP_ALLOWED_ORIGINS=
